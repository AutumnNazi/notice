# 构建产物
build/
dist/

# 打包过程产物：_dist_data_preserved 是 build.py 为防覆盖而备份的 data/，
# 内含用户真实提醒内容，打包中断残留时绝不能入库
_dist_data_preserved/
_wake_build/

# Python 缓存
__pycache__/
*.pyc

# IDE
.idea/

# 用户本地数据（含真实提醒内容，不上传）
data/tasks.json
data/settings.json

# 运行期生成的图标（由 core/icon_assets.py 的 ensure_icon_assets() 生成）
data/app_icon*.png
data/app_icon.ico
data/tray_icon.png
data/toast_image.png

# 开发过程截图
ui_*.png

# 已被 core/live_info.py 与 tests/ 取代的过程草稿
work/

# 运行日志：程序把启动与唤醒过程写到 data/logs/，属于本机运行痕迹
data/logs/

# store.py 读到损坏 JSON 时留档的副本（命名如 tasks.json.corrupt-20260213-101530），
# 里面是用户尚未修复的原始内容，留档给本机排查但不入库
data/*.corrupt-*
